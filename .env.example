# docparse environment variables (sample)
#
# Copy this file to ".env" and fill in only the keys for the parsers you use.
# Each parser under parsers/ is independent: if a key is missing, that parser
# prints an install/setup hint and the others keep working.
#
#   cp .env.example .env
#
# Never commit your real ".env" file. All values below are intentionally blank.

# --- LlamaParse v2 (parsers/llamaparse_parse.py) ---
# Primary parser for medium and larger PDFs (agentic tier).
# Get a key: https://cloud.llamaindex.ai/
LLAMAPARSE_API_KEY=

# --- Upstage Document Parse (parsers/upstage_parse.py) ---
# Cross-validation parser, strongest at completeness and metadata.
# Get a key: https://console.upstage.ai/
UPSTAGE_API_KEY=

# --- Google Gemini (parsers/gemini_parse.py, scripts/generate_alt_text.py) ---
# Small-PDF primary parser and alt-text generation.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Mistral (parsers/mistral_parse.py) ---
# Three-way cross-validation, large-document completeness, non-Korean material.
# Get a key: https://console.mistral.ai/
MISTRAL_API_KEY=

# --- Corepin (parsers/corepin_parse.py) ---
# AI3 OSS engine router (multi-format single API), Korean filtering SLM.
# Get a key: https://corepin.ai/
COREPIN_API_KEY=

# --- Cohere Parse (parsers/cohere_parse.py) ---
# parse-v5.0. Korean is one of the nine stable languages; $1.50 per 1,000 pages.
# The endpoint takes images only, so PDF pages are rendered and sent one call per page.
# Get a key (trial keys are free, 1,000 calls/month): https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# --- OpenAI (parsers/openai_parse.py) ---
# General-purpose multimodal parsing through the Responses API (OpenAI has no
# dedicated parser/OCR endpoint). Default model gpt-5.6-terra; PDFs are split into
# page windows and sent one call per window to curb long-document summarisation.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Anthropic Claude (parsers/anthropic_parse.py) ---
# General-purpose multimodal parsing through the Messages API (no dedicated parser/OCR
# endpoint). Default model claude-opus-5-5; PDFs and images only. The parser reads the
# parser-specific name first so that a plain ANTHROPIC_API_KEY in your shell does not
# switch other tools (e.g. Claude Code) to metered API billing; ANTHROPIC_API_KEY is the fallback.
# Get a key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY_DOCPARSE=

# --- Azure Document Intelligence (parsers/azure_parse.py) ---
# Non-LLM OCR + layout (prebuilt-layout, REST 2024-11-30): markdown with HTML tables and
# per-word confidence. Needs BOTH the key and the resource endpoint. The free F0 tier only
# processes the first 2 pages of a document; use an S0 resource for real documents.
# Fallback names: DOCUMENTINTELLIGENCE_API_KEY / DOCUMENTINTELLIGENCE_ENDPOINT.
# Create a resource: az cognitiveservices account create --kind FormRecognizer --sku S0 ...
AZURE_DOCINTEL_API_KEY_DOCPARSE=
# e.g. https://<resource-name>.cognitiveservices.azure.com/
AZURE_DOCINTEL_ENDPOINT_DOCPARSE=

# --- Google Cloud Vision OCR (parsers/gvision_parse.py) ---
# Non-LLM OCR with per-word confidence, for handwriting / verbatim transcription.
# Use EITHER the API key below, OR the GV_TOKEN + GV_PROJECT pair further down.
# Get an API key: https://console.cloud.google.com/apis/credentials
# Enable the Vision API: https://console.cloud.google.com/apis/library/vision.googleapis.com
GOOGLE_VISION_API_KEY=

# Alternative Vision auth: OAuth access token + project id (instead of GOOGLE_VISION_API_KEY).
# GV_TOKEN is an access token, e.g. the output of: gcloud auth print-access-token
GV_TOKEN=
# GV_PROJECT is your Google Cloud project id.
GV_PROJECT=
